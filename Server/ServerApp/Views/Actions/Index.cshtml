@model IEnumerable<ServerApp.Models.ActionRecord>

@{
    ViewData["Title"] = "Керування Actions (Matchup Guides)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text text-warning"></i> Тактичні гайди дій (Actions)</h2>
    <a asp-action="Create" class="btn btn-warning text-dark fw-bold">
        <i class="bi bi-plus-circle"></i> Створити гайд
    </a>
</div>

<div class="card card-custom">
    <div class="card-body p-0 table-responsive">
        <table class="table table-custom table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Наш чемпіон (Item)</th>
                    <th>Опонент на лінії</th>
                    <th>Тактичний план</th>
                    <th>Статус</th>
                    <th>Автор (User)</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-secondary">
                        Гайдів ще немає. Натисніть кнопку вище, щоб сформувати перший тактичний план проти ворожого чемпіона!
                    </td>
                </tr>
            }
            @foreach (var action in Model)
            {
                <tr>
                    <td>@action.ID</td>
                    <td class="fw-bold text-success">@(action.Item?.ChampionName ?? "ID " + action.ItemID)</td>
                    <td class="fw-bold text-danger">vs @action.OpponentChampion</td>
                    <td><small>@action.ActionDetails</small></td>
                    <td>
                        @if (action.Status == "Approved")
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (action.Status == "Archived")
                        {
                            <span class="badge bg-secondary">Archived</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Draft</span>
                        }
                    </td>
                    <td><span class="badge bg-primary">@(action.User?.Name ?? "ID " + action.UserID)</span></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@action.ID" class="btn btn-sm btn-outline-warning me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@action.ID" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>