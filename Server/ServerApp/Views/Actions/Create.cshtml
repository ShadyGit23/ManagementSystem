@model ServerApp.Models.ActionRecord

@{
    ViewData["Title"] = "Створити гайд дій";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-custom p-4">
            <h3 class="mb-4 text-warning"><i class="bi bi-journal-plus"></i> Додати гайд дій (Action)</h3>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="ItemID" class="form-label">Наш чемпіон (Item)</label>
                    <select asp-for="ItemID" class="form-select" asp-items="ViewBag.Items" required></select>
                </div>

                <div class="mb-3">
                    <label asp-for="OpponentChampion" class="form-label">Ворожий опонент на лінії</label>
                    <input asp-for="OpponentChampion" class="form-control" placeholder="Zed, Syndra, Renekton..." required />
                </div>

                <div class="mb-3">
                    <label asp-for="ActionDetails" class="form-label">Покроковий тактичний план</label>
                    <textarea asp-for="ActionDetails" class="form-control" rows="3" placeholder="Зберігати Windwall під ультимейт Зеда, купувати Plated Steelcaps на першому поверненні..." required></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Статус гайду</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Draft" selected>Draft (Чернетка)</option>
                        <option value="Approved">Approved (Затверджено тренером)</option>
                        <option value="Archived">Archived (Архів)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="UserID" class="form-label">Автор тактики (User)</label>
                    <select asp-for="UserID" class="form-select" asp-items="ViewBag.Users" required></select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Назад</a>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">Зберегти гайд</button>
                </div>
            </form>
        </div>
    </div>
</div>