@model ServerApp.Models.ActionRecord

@{
    ViewData["Title"] = "Редагувати гайд";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-custom p-4">
            <h3 class="mb-4 text-warning"><i class="bi bi-pencil-square"></i> Редагувати тактику #@Model.ID</h3>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ID" />

                <div class="mb-3">
                    <label asp-for="ItemID" class="form-label">Наш чемпіон</label>
                    <select asp-for="ItemID" class="form-select" asp-items="ViewBag.Items" required></select>
                </div>

                <div class="mb-3">
                    <label asp-for="OpponentChampion" class="form-label">Ворожий опонент</label>
                    <input asp-for="OpponentChampion" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="ActionDetails" class="form-label">Тактичний план</label>
                    <textarea asp-for="ActionDetails" class="form-control" rows="3" required></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Статус</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Draft">Draft</option>
                        <option value="Approved">Approved</option>
                        <option value="Archived">Archived</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="UserID" class="form-label">Автор</label>
                    <select asp-for="UserID" class="form-select" asp-items="ViewBag.Users" required></select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">Оновити</button>
                </div>
            </form>
        </div>
    </div>
</div>