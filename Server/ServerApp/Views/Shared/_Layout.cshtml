<!DOCTYPE html>
<html lang="uk" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — LoL Matchup Admin</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #0b132b;
            color: #e2e8f0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-custom {
            background-color: #1c2541;
            border-bottom: 2px solid #3a506b;
        }
        .card-custom {
            background-color: #1c2541;
            border: 1px solid #3a506b;
            border-radius: 10px;
        }
        .table-custom {
            --bs-table-bg: #1c2541;
            --bs-table-color: #e2e8f0;
            --bs-table-border-color: #3a506b;
        }
        .footer {
            margin-top: auto;
            background-color: #1c2541;
            border-top: 1px solid #3a506b;
            padding: 15px 0;
            font-size: 14px;
            color: #94a3b8;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold text-info" asp-controller="Admin" asp-action="Index">
                    ⚔️ LoL Matchup & Armory
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-auto"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Дашборд
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Index">
                                <i class="bi bi-people"></i> 1. Users (Strategists)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Items" asp-action="Index">
                                <i class="bi bi-shield-shaded"></i> 2. Items (Loadouts)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Actions" asp-action="Index">
                                <i class="bi bi-journal-text"></i> 3. Actions (Guides)
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-primary px-3 py-2">
                            <i class="bi bi-person-check-fill"></i> @User.Identity?.Name
                        </span>
                        <a href="/Auth/Logout" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Вийти
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mb-5">
        @RenderBody()
    </main>

    <footer class="footer text-center">
        <div class="container">
            <span>League of Legends Matchup Management System &copy; 2026 — ASP.NET Core 10 MVC Admin Panel</span>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>