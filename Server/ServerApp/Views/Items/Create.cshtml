@model ServerApp.Models.Item

@{
    ViewData["Title"] = "Створити сетап чемпіона";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-custom p-4">
            <h3 class="mb-4 text-success"><i class="bi bi-plus-square"></i> Додати сетап чемпіона (Item)</h3>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="ChampionName" class="form-label">Ім'я чемпіона</label>
                    <input asp-for="ChampionName" class="form-control" placeholder="Yasuo, Ahri, Aatrox..." required />
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Позиція / Роль</label>
                    <select asp-for="Role" class="form-select" required>
                        <option value="Top">Top</option>
                        <option value="Jungle">Jungle</option>
                        <option value="Mid" selected>Mid</option>
                        <option value="ADC">ADC</option>
                        <option value="Support">Support</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="CoreItemBuild" class="form-label">Основні предмети (Core Build)</label>
                    <input asp-for="CoreItemBuild" class="form-control" placeholder="Kraken Slayer -> Infinity Edge -> Immortal Shieldbow" required />
                </div>

                <div class="mb-3">
                    <label asp-for="RuneSetup" class="form-label">Руни (Rune Setup)</label>
                    <input asp-for="RuneSetup" class="form-control" placeholder="Lethal Tempo + Resolve (Second Wind / Overgrowth)" required />
                </div>

                <div class="mb-3">
                    <label asp-for="UserID" class="form-label">Автор збірки (Користувач)</label>
                    <select asp-for="UserID" class="form-select" asp-items="ViewBag.Users" required></select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Назад</a>
                    <button type="submit" class="btn btn-success">Створити сетап</button>
                </div>
            </form>
        </div>
    </div>
</div>