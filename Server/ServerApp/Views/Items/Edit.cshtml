@model ServerApp.Models.Item

@{
    ViewData["Title"] = "Редагувати сетап";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-custom p-4">
            <h3 class="mb-4 text-warning"><i class="bi bi-pencil-square"></i> Редагувати сетап @Model.ChampionName</h3>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ID" />

                <div class="mb-3">
                    <label asp-for="ChampionName" class="form-label">Ім'я чемпіона</label>
                    <input asp-for="ChampionName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Позиція</label>
                    <select asp-for="Role" class="form-select" required>
                        <option value="Top">Top</option>
                        <option value="Jungle">Jungle</option>
                        <option value="Mid">Mid</option>
                        <option value="ADC">ADC</option>
                        <option value="Support">Support</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="CoreItemBuild" class="form-label">Предмети</label>
                    <input asp-for="CoreItemBuild" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="RuneSetup" class="form-label">Руни</label>
                    <input asp-for="RuneSetup" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="UserID" class="form-label">Автор (User)</label>
                    <select asp-for="UserID" class="form-select" asp-items="ViewBag.Users" required></select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
                    <button type="submit" class="btn btn-warning">Зберегти зміни</button>
                </div>
            </form>
        </div>
    </div>
</div>