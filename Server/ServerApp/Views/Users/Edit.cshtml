@model ServerApp.Models.User

@{
    ViewData["Title"] = "Редагувати користувача";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <h3 class="mb-4 text-warning"><i class="bi bi-pencil-square"></i> Редагувати користувача #@Model.ID</h3>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ID" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Нікнейм</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordHash" class="form-label">Пароль / Хеш</label>
                    <input asp-for="PasswordHash" class="form-control" required />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
                    <button type="submit" class="btn btn-warning">Оновити дані</button>
                </div>
            </form>
        </div>
    </div>
</div>