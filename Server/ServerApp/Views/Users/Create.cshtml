@model ServerApp.Models.User

@{
    ViewData["Title"] = "Додати користувача";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <h3 class="mb-4 text-primary"><i class="bi bi-person-plus"></i> Створити користувача</h3>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Нікнейм аналітика / гравця</label>
                    <input asp-for="Name" class="form-control" placeholder="Наприклад: Faker або Caps" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email адреса</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="faker@t1.gg" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordHash" class="form-label">Пароль / Хеш</label>
                    <input asp-for="PasswordHash" class="form-control" placeholder="Введіть тестовий пароль" required />
                    <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
                    <button type="submit" class="btn btn-primary">Зберегти в БД</button>
                </div>
            </form>
        </div>
    </div>
</div>