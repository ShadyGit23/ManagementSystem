@model ServerApp.Models.User

@{
    ViewData["Title"] = "Видалення користувача";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom border-danger p-4">
            <h3 class="text-danger mb-3"><i class="bi bi-exclamation-triangle"></i> Видалення запису</h3>
            <p>Ви дійсно бажаєте видалити користувача <strong>@Model.Name</strong> (ID: @Model.ID)?</p>
            <div class="alert alert-warning small">
                <strong>Увага:</strong> Зв'язок каскадного видалення (ON DELETE CASCADE) також автоматично видалить усі прив'язані до цього користувача збірки чемпіонів та гайди дій!
            </div>

            <form asp-action="Delete" method="post" class="d-flex justify-content-between mt-3">
                <input type="hidden" asp-for="ID" />
                <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
                <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
            </form>
        </div>
    </div>
</div>
